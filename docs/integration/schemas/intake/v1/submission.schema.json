{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.discover.legal/biglaw/intake/v1/submission.schema.json",
  "title": "Submission (portal view)",
  "description": "A submission as returned on the portal (HMAC) routes. status: consumers MUST map unknown values to in_review. On conflict_hold the client is still a prospect: clientId/clientNumber/documentId/matterNumber may be empty. Tolerant reader: receivers MUST ignore properties they do not know; additionalProperties is therefore never false in this contract.",
  "type": "object",
  "required": [
    "id",
    "externalId",
    "crmProfileId",
    "clientId",
    "clientNumber",
    "title",
    "status",
    "conflict",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "externalId": {
      "type": "string",
      "minLength": 1
    },
    "crmProfileId": {
      "type": "string",
      "minLength": 1
    },
    "clientId": {
      "type": "string"
    },
    "clientNumber": {
      "type": "string"
    },
    "matterNumber": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "documentType": {
      "type": "string"
    },
    "matterType": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "practiceArea": {
      "type": "string"
    },
    "noslegal": {
      "$ref": "noslegal.schema.json"
    },
    "documentId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "conflict_hold",
        "in_review",
        "ready",
        "rejected"
      ],
      "description": "BigLaw emits only these; consumers treat unknown values as in_review."
    },
    "note": {
      "type": "string"
    },
    "assignedTo": {
      "type": "string"
    },
    "assignedToName": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "conflict": {
      "$ref": "conflict.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
