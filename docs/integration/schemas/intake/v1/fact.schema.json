{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.discover.legal/biglaw/intake/v1/fact.schema.json",
  "title": "Fact",
  "description": "A CRM fact under bidirectional consent. Tolerant reader: receivers MUST ignore properties they do not know; additionalProperties is therefore never false in this contract.",
  "type": "object",
  "required": [
    "id",
    "category",
    "value",
    "source",
    "proposedBy",
    "approverRole",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "identity",
        "contact",
        "family",
        "financial",
        "employment",
        "matter",
        "adverse_party",
        "goal",
        "concern",
        "constraint",
        "preference",
        "history",
        "note"
      ]
    },
    "predicate": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Known values: client, lawyer, intake, system."
    },
    "proposedBy": {
      "type": "string",
      "description": "\"client:<externalRef>\" or \"lawyer:<profileId>\"."
    },
    "approverRole": {
      "type": "string",
      "enum": [
        "lawyer",
        "client"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "decidedBy": {
      "type": "string"
    },
    "decisionNote": {
      "type": "string"
    },
    "supersededBy": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
