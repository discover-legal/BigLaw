{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.discover.legal/biglaw/intake/v1/decision-request.schema.json",
  "title": "POST /intake/proposals/:id/decision request",
  "description": "Tolerant reader: receivers MUST ignore properties they do not know; additionalProperties is therefore never false in this contract.",
  "type": "object",
  "required": [
    "clientExternalId",
    "decision"
  ],
  "properties": {
    "clientExternalId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}
