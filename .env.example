# Copy to .env (never commit .env or .env.*). docker compose reads it for
# interpolation. Required by docker-compose.yml. Use a hex password; README
# § Run it writes one in. Compose does not run $(...) written in this file.
# If you choose your own, single-quote it (POSTGRES_PASSWORD='...') and do
# not use ' in it: unquoted, Compose cuts the value at " #" and expands $.
# (It reaches biglaw as PGPASSWORD, so URL characters need no encoding.)
POSTGRES_PASSWORD=

# The AI model: any OpenAI-compatible API base, ending in its version. A key
# or a model role needs the URL too. BIGLAW_MODELS names a model per role:
# lead runs tasks (required to run one); embed adds meaning-based search
# (without it search matches words only); vision reads scans and photos
# (without it they are stored and wait). Fill the three lines below from one
# recipe (copy its values, keep the lines uncommented); setup.sh (README
# § Install) fills them from your answers:
#
#   OpenAI:
#     BIGLAW_MODEL_URL=https://api.openai.com/v1
#     BIGLAW_MODEL_KEY=<your key>
#     BIGLAW_MODELS=lead=gpt-4.1,embed=text-embedding-3-small,vision=gpt-4.1
#   Anthropic (its OpenAI-compatible endpoint; also set ALLOW_ANTHROPIC=1 in
#   this file, which lets BigLaw send matter text to Anthropic):
#     BIGLAW_MODEL_URL=https://api.anthropic.com/v1
#     BIGLAW_MODEL_KEY=<your key>
#     BIGLAW_MODELS=lead=<a Claude model id>,vision=<a Claude model id>
#   Any other OpenAI-compatible gateway (OpenRouter, a firm proxy, vLLM):
#     BIGLAW_MODEL_URL=https://openrouter.ai/api/v1
#     BIGLAW_MODEL_KEY=<your key>
#     BIGLAW_MODELS=lead=<provider/model id>
#   Ollama on this computer (no key; docker-compose.yml maps
#   host.docker.internal to the host, since localhost is the container itself):
#     BIGLAW_MODEL_URL=http://host.docker.internal:11434/v1
#     BIGLAW_MODELS=lead=qwen2.5:14b,embed=nomic-embed-text
#   (Set BIGLAW_LOCAL_WATTS to your GPU's watts to see a task's energy use.)
BIGLAW_MODEL_URL=
BIGLAW_MODEL_KEY=
BIGLAW_MODELS=

# Sign-in (OIDC, README § Sign-in). Set the issuer and client id together
# (the secret too for a confidential client), or none. BIGLAW_PUBLIC_URL is
# how browsers reach BigLaw: https://host (http only on 127.0.0.1); the
# redirect URI to register at the issuer is <BIGLAW_PUBLIC_URL>/auth/callback.
# BIGLAW_ADMINS: comma-separated verified emails or subjects (sub) of admins;
# everyone else the issuer signs in is a member. For example:
#   BIGLAW_PUBLIC_URL=https://biglaw.example.com
#   BIGLAW_OIDC_ISSUER=https://idp.example.com/realms/biglaw
#   BIGLAW_OIDC_CLIENT_ID=biglaw
#   BIGLAW_ADMINS=ada@example.com
BIGLAW_PUBLIC_URL=
BIGLAW_OIDC_ISSUER=
BIGLAW_OIDC_CLIENT_ID=
BIGLAW_OIDC_CLIENT_SECRET=
BIGLAW_ADMINS=
