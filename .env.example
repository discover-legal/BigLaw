# Copy to .env (never commit .env or .env.*). docker compose reads it for
# interpolation. Required by docker-compose.yml. Use a hex password; README
# § Run it writes one in. Compose does not run $(...) written in this file.
# If you choose your own, single-quote it (POSTGRES_PASSWORD='...') and do
# not use ' in it: unquoted, Compose cuts the value at " #" and expands $.
# (It reaches biglaw as PGPASSWORD, so URL characters need no encoding.)
POSTGRES_PASSWORD=

# Model endpoint: any OpenAI-compatible API base, ending in its version
# (e.g. http://host.docker.internal:11434/v1 for Ollama on this computer). A key or a model role needs the URL too.
# BIGLAW_MODELS names a model per role, e.g.
#   lead=qwen2.5:14b,embed=nomic-embed-text
# Only embed is called so far (hybrid search; without it search is lexical
# only); the agent loop that calls lead lands in PR 4a.
BIGLAW_MODEL_URL=
BIGLAW_MODEL_KEY=
BIGLAW_MODELS=

# Sign-in (OIDC, README § Sign-in). Set the issuer and client id together
# (the secret too for a confidential client), or none. BIGLAW_PUBLIC_URL is
# how browsers reach BigLaw: https://host (http only on 127.0.0.1); the
# redirect URI to register at the issuer is <BIGLAW_PUBLIC_URL>/auth/callback.
# BIGLAW_ADMINS: comma-separated verified emails or subjects (sub) of admins;
# everyone else the issuer signs in is a member. For example:
#   BIGLAW_PUBLIC_URL=https://biglaw.example.com
#   BIGLAW_OIDC_ISSUER=https://idp.example.com/realms/biglaw
#   BIGLAW_OIDC_CLIENT_ID=biglaw
#   BIGLAW_ADMINS=ada@example.com
BIGLAW_PUBLIC_URL=
BIGLAW_OIDC_ISSUER=
BIGLAW_OIDC_CLIENT_ID=
BIGLAW_OIDC_CLIENT_SECRET=
BIGLAW_ADMINS=
