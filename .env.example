# Copy to .env (never commit .env or .env.*). docker compose reads it for
# interpolation. Required by docker-compose.yml; any characters work (it is
# passed to biglaw as PGPASSWORD, not inside the URL). Example:
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Model endpoint (any OpenAI-compatible base URL). This build reads only
# BIGLAW_MODEL_URL (for the vendor breaker); the model client lands in PR 2.
BIGLAW_MODEL_URL=
BIGLAW_MODEL_KEY=
BIGLAW_MODEL_LEAD=

# Browser login (OIDC). Set all three, or none. Read from PR 8.
BIGLAW_PUBLIC_URL=
BIGLAW_OIDC_ISSUER=
BIGLAW_OIDC_CLIENT_ID=
BIGLAW_OIDC_CLIENT_SECRET=
