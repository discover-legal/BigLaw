# Copy to .env (never commit .env). docker compose reads it for interpolation.
# Required by docker-compose.yml. Use URL-safe characters: it is embedded in
# the database URL. Example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Model endpoint (any OpenAI-compatible base URL). Not used by anything in
# this build yet; the model client lands in PR 2.
BIGLAW_MODEL_URL=
BIGLAW_MODEL_KEY=
BIGLAW_MODEL_LEAD=

# Browser login (OIDC). Set all three, or none. The login flow lands in PR 8.
BIGLAW_OIDC_ISSUER=
BIGLAW_OIDC_CLIENT_ID=
BIGLAW_OIDC_CLIENT_SECRET=
