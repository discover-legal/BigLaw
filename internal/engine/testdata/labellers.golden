"type\":[\"string\",\"null\"],\"maxLength\":300},\"isRange\":{\"type\":\"boolean\"},\"rangeWith\":{\"type\":[\"string\",\"null\"],\"maxLength\":32},\"sign\":{\"type\":\"string\",\"maxLength\":16},\"measures\":{\"type\":[\"string\",\"null\"],\"maxLength\":120},\"period\":{\"type\":[\"string\",\"null\"],\"maxLength\":80},\"typedEntity\":{\"type\":[\"string\",\"null\"],\"maxLength\":16},\"counterparty\":{\"type\":[\"string\",\"null\"],\"maxLength\":300},\"unit\":{\"type\":[\"string\",\"null\"],\"maxLength\":24},\"unitFrom\":{\"type\":[\"string\",\"null\"],\"maxLength\":40}}}}}}"},{"role":"user","content":"Request:\n{\"findings\":[{\"id\":\"1\",\"parties\":[],\"passages\":[{\"id\":\"1.q1\",\"kind\":\"quote\",\"documentId\":\"<id5>\",\"text\":\"First lot 3 costs $103,000 and 24 units.\",\"class\":null,\"unit\":null,\"entity\":null,\"metric\":null,\"spans\":[{\"id\":\"1.q1.s1\",\"text\":\"3\"},{\"id\":\"1.q1.s2\",\"text\":\"103,000\"},{\"id\":\"1.q1.s3\",\"text\":\"24\"}]}]},{\"id\":\"2\",\"parties\":[],\"passages\":[{\"id\":\"2.q1\",\"kind\":\"quote\",\"documentId\":\"<id5>\",\"text\":\"First fee schedule lists $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, and $2,000.\",\"class\":null,\"unit\":null,\"entity\":null,\"metric\":null,\"spans\":[{\"id\":\"2.q1.s1\",\"text\":\"1,000\"},{\"id\":\"2.q1.s2\",\"text\":\"1,000\"},{\"id\":\"2.q1.s3\",\"text\":\"1,000\"},{\"id\":\"2.q1.s4\",\"text\":\"1,000\"},{\"id\":\"2.q1.s5\",\"text\":\"1,000\"},{\"id\":\"2.q1.s6\",\"text\":\"1,000\"},{\"id\":\"2.q1.s7\",\"text\":\"1,000\"},{\"id\":\"2.q1.s8\",\"text\":\"1,000\"},{\"id\":\"2.q1.s9\",\"text\":\"1,000\"},{\"id\":\"2.q1.s10\",\"text\":\"1,000\"},{\"id\":\"2.q1.s11\",\"text\":\"1,000\"},{\"id\":\"2.q1.s12\",\"text\":\"1,000\"},{\"id\":\"2.q1.s13\",\"text\":\"1,000\"},{\"id\":\"2.q1.s14\",\"tex