"type\":[\"string\",\"null\"],\"maxLength\":300},\"isRange\":{\"type\":\"boolean\"},\"rangeWith\":{\"type\":[\"string\",\"null\"],\"maxLength\":32},\"sign\":{\"type\":\"string\",\"maxLength\":16},\"measures\":{\"type\":[\"string\",\"null\"],\"maxLength\":120},\"period\":{\"type\":[\"string\",\"null\"],\"maxLength\":80},\"typedEntity\":{\"type\":[\"string\",\"null\"],\"maxLength\":16},\"counterparty\":{\"type\":[\"string\",\"null\"],\"maxLength\":300},\"unit\":{\"type\":[\"string\",\"null\"],\"maxLength\":24},\"unitFrom\":{\"type\":[\"string\",\"null\"],\"maxLength\":40}}}}}}"},{"role":"user","content":"Request:\n{\"findings\":[{\"id\":\"1\",\"parties\":[],\"passages\":[{\"id\":\"1.q1\",\"kind\":\"quote\",\"documentId\":\"<id5>\",\"text\":\"First lot 0 costs $100,000 and 3 units.\",\"class\":null,\"unit\":null,\"entity\":null,\"metric\":null,\"spans\":[{\"id\":\"1.q1.s1\",\"text\":\"0\"},{\"id\":\"1.q1.s2\",\"text\":\"100,000\"},{\"id\":\"1.q1.s3\",\"text\":\"3\"}]}]},{\"id\":\"2\",\"parties\":[],\"passages\":[{\"id\":\"2.q1\",\"kind\":\"quote\",\"documentId\":\"<id5>\",\"text\":\"First lot 1 costs $101,000 and 10 units.\",\"class\":null,\"unit\":null,\"entity\":null,\"metric\":null,\"spans\":[{\"id\":\"2.q1.s1\",\"text\":\"1\"},{\"id\":\"2.q1.s2\",\"text\":\"101,000\"},{\"id\":\"2.q1.s3\",\"text\":\"10\"}]}]},{\"id\":\"3\",\"parties\":[],\"passages\":[{\"id\":\"3.q1\",\"kind\":\"quote\",\"documentId\":\"<id5>\",\"text\":\"First lot 3 costs $103,000 and 24 units.\",\"class\":null,\"unit\":null,\"entity\":null,\"metric\":null,\"spans\":[{\"id\":\"3.q1.s1\",\"text\":\"3\"},{\"id\":\"3.q1.s2\",\"text\":\"103,000\"},{\"id\":\"3.q1.s3\",\"text\":\"24\"}]}]},{\"id\":\"4\",\"parties\":[],\"passages\":[{\"id\":\"4.q1\",\"kind\":\"quote\",\"documentId\":\"<id5>\",\"text\":\"First fee schedule lists $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,000, $1,0